{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@jcvital-panel": ["./src/adapters/jcvital/ElitePlusV8Panel.tsx"],
      "@v8-physical-semantic-tests": ["./src/adapters/jcvital/V8PhysicalSemanticTests.tsx"],
      "@engineering-surfaces": ["./src/EngineeringSurfaces.ts"],
      "@connection-diagnostic-panel": ["./src/adapters/jcvital/ConnectionDiagnosticPanelStub.tsx"]
    }
  },
  "include": ["src"]
}
